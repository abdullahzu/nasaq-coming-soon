{
  "name": "nasaq-cloudflare-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "verify": "npm run test && npm run check:source && npm run check:worker",
    "dev": "wrangler dev",
    "deploy": "npm run verify && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  }
}
