{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nasaq-coming-soon",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "growth@nasaqfb.com",
      "allowed_sender_addresses": [
        "website@nasaqfb.com"
      ]
    }
  ]
}
